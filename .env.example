SOP_ENV=development
SOP_DATABASE_URL=postgresql+psycopg://sop_igs:change-me@127.0.0.1:5432/sop_igs
SOP_DATA_ROOT=D:/SOP-IGS-Data
SOP_SESSION_COOKIE_SECURE=true
SOP_SECRET_KEY=change-this-to-a-long-random-value
SOP_BOOTSTRAP_ADMIN_USERNAME=admin
SOP_BOOTSTRAP_ADMIN_PASSWORD=change-me-now
SOP_WORD_COM_ENABLED=true
SOP_DISPLAY_TIMEZONE=Asia/Shanghai
SOP_LLM_BASE_URL=
SOP_LLM_API_KEY=
SOP_LLM_MODEL=
# Feishu SSO: register ${base}/api/auth/feishu/callback in the Feishu app security settings.
SOP_FEISHU_APP_ID=
SOP_FEISHU_APP_SECRET=
# Comma-separated open_ids granted admin on login.
SOP_FEISHU_ADMIN_OPEN_IDS=
# Optional fixed external URL (e.g. https://sop.example.com); otherwise derived from the request.
SOP_PUBLIC_BASE_URL=
